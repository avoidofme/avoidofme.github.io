---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="bg-brand-black p-4">
        <h1 class="text-3xl font-bold tracking-tight">Skills</h1>
        <div class="flex">
            <div class="bg-brand-gray">
                <h1>Languages</h1>
                <div>
                    <p>Python</p>
                    <p>Go</p>
                    <p>JavaScript</p>
                    <p>TypeScript</p>
                    <p>C</p>
                    <p>Zig</p>
                    <p>Shell</p>
                </div>
            </div>
            <div class="bg-brand-gray">
                <h1>Tools</h1>
                <div>
                    <p>Docker</p>
                    <p>Incus</p>
                    <p>Ansible</p>
                    <p>Neovim</p>
                    <p>Git</p>
                    <p>Qemu</p>
                    <p>Nmap</p>
                    <p>Sqlmap</p>
                    <p>Burpsuite</p>
                    <p>Zaproxy</p>
                    <p>Wireshark</p>
                    <p>John</p>
                    <p>Ghidra</p>
                </div>
            </div>
        </div>
    </div>
</Layout>
