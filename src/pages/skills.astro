---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="bg-brand-black p-4">
        <h1 class="text-3xl font-bold tracking-tight mb-4">Skills</h1>
        <div class="flex">
            <div class="flex-1 border border-brand-gray p-4 bg-brand-bg">
                <h1 class="text-xl font-bold tracking-tight">Languages</h1>
                <div class="py-2 mt-2 border-t">
                    <p>Python</p>
                    <p>Go</p>
                    <p>JavaScript</p>
                    <p>TypeScript</p>
                    <p>C</p>
                    <p>Zig</p>
                    <p>Shell</p>
                </div>
            </div>
            <div class="flex-1 border border-brand-gray p-4 bg-brand-bg">
                <h1 class="text-xl font-bold tracking-tight">Tools</h1>
                <div class="py-2 mt-2 border-t">
                    <p>Docker</p>
                    <p>Incus</p>
                    <p>Ansible</p>
                    <p>Neovim</p>
                    <p>Git</p>
                    <p>Qemu</p>
                    <p>Nmap</p>
                    <p>Sqlmap</p>
                    <p>Burpsuite</p>
                    <p>Zaproxy</p>
                    <p>Wireshark</p>
                    <p>John</p>
                    <p>Ghidra</p>
                </div>
            </div>
        </div>
    </div>
</Layout>
