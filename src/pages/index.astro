---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<div class="p-4 pt-20 mt-20">
		<div class="border border-0 flex w-fit items-end mx-auto">
			<button
				class="border-r border-0 cursor-pointer text-5xl text-9 font-extrabold tracking-tighter"
			>
				avoidofme
			</button>
			<p class="border-t border-0 text-10 font-bold">+1</p>
		</div>
		<div class="bg-0 p-2 w-xl max-w-full flex flex-col mt-12 mx-auto">
			<p>continue to homepage.</p>
			<a
				class="p-2 text-xl text-center font-extrabold tracking-tighter
				bg-brand-green border border-brand-green text-0
				md:bg-0 md:hover:bg-brand-green md:text-brand-fg md:hover:text-0
				transition-color duration-150"
				href="/home">home</a
			>
		</div>
	</div>
</Layout>
