---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<div class="p-4 pt-20 mt-20">
		<div class="border border-brand-black flex w-fit items-end mx-auto">
			<button
				class="border-r border-brand-black cursor-pointer text-5xl text-brand-red font-extrabold tracking-tighter"
			>
				avoidofme
			</button>
			<p
				class="border-t border-brand-black text-brand-lightyellow font-bold"
			>
				+1
			</p>
		</div>
		<div
			class="bg-brand-black p-2 w-xl max-w-full flex flex-col mt-12 mx-auto"
		>
			<p>continue to homepage.</p>
			<a
				class="p-2 text-xl text-center font-extrabold tracking-tighter
				bg-brand-green border border-brand-green text-brand-black
				md:bg-brand-black md:hover:bg-brand-green md:text-brand-fg md:hover:text-brand-black
				transition-color duration-150"
				href="/home">home</a
			>
		</div>
	</div>
</Layout>
