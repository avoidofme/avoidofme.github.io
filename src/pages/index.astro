---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';

import { getCollection } from 'astro:content';
const recent_posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 6);

---

<!doctype html>
<html lang="en">
	<head>
    <BaseHead title=`Home | ${SITE_TITLE}` description={SITE_DESCRIPTION} />
  </head>
  <style>
    li>a {
      text-decoration: none;
      display: flex;
      gap: 1em;
    }

    time {
      margin: 0;
    }

    .date {
      font-size: 0.5em;
      color: var(--fg);
    }

    .date::before {
      content: '— ';
    }
  </style>
	<body>
		<Header />
		<main>
      <h1>avoidofme</h1>
      <hr style="margin: 0 0 1.5em 0" />
      <details class="opts" open>
        <summary>Latest from the blog</summary>
        <ul>
					{
						recent_posts.map((post) => (
						  <li>
				    		<a href={`/blog/${post.id}/`}>
                  <p>{post.data.title}</p>
                  <p class="date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
								</a>
							</li>
						))
          }
				</ul>
      </details>
      <details class="opts">
        <summary>Projects</summary>
        <div style="padding: 1em">
          <div>
            <a href="https://github.com/avoidofme/avps" target="_blank"><h3>AvPS</h3></a>
            <p>avps is a multi-threading tcp port scanner, built using go and it's goroutine.</p>
          </div>
          <h2 style="margin-top: 2em">Personal Projects</h2>
          <div>
            <a href="https://github.com/avoidofme/igtd" target="_blank"><h3>igtd</h3></a>
            <p>Image goes to dracula. I make this command line tool because i recently use dracula theme. Because there are many cool images already why not just change the color into dracula? for now since i need it to work, i use python with pillow for image manipulation.</p>
          </div>
          <div>
            <a href="https://github.com/avoidofme/von-da-bot" target="_blank"><h3>Von</h3></a>
            <p>Von is a bot specifically for my discord server. I use compose to start the bot, backend and database. Python for the bot, Go for backend and postgresql for database.</p>
          </div>
        </div>
      </details>
      <details class="opts">
        <summary>Currently</summary>
        <p>Learning Cybersecurity, building personal projects and doing CTFs in my free time.</p>
      </details>
      <details class="opts">
        <summary>Links</summary>
        <ul>
          <li>
            <a href="https://github.com/avoidofme" target="_blank">
              <p>Github</p>
            </a>
          </li>
          <li>
            <a href="https://linkedin.com/in/avoidofme" target="_blank">
              <p>LinkedIn</p>
            </a>
          </li>
          <li>
            <a href="https://learn.cylabacademy.org/users/avoidofme" target="_blank">
              <p>CyLab</p>
            </a>
          </li>
          <li>
            <a href="https://tryhackme.com/p/avoidofme" target="_blank">
              <p>TryHackMe</p>
            </a>
          </li>
          <li>
            <a href="https://wakatime.com/@avoidofme" target="_blank">
              <p>Wakatime</p>
            </a>
          </li>
          <li>
            <a href="https://freecodecamp.org/avoidofme" target="_blank">
              <p>freeCodeCamp</p>
            </a>
          </li>
          <li>
            <a href="https://bugcrowd.com/h/avoidofme" target="_blank">
              <p>bugcrowd</p>
            </a>
          </li>
          <li>
            <a href="https://leetcode.com/u/avom_valtz" target="_blank">
              <p>LeetCode</p>
            </a>
          </li>
          <li>
            <a href="https://discord.gg/7GCehbumej" target="_blank">
              <p>Discord Server</p>
            </a>
          </li>
        </ul>
      </details>
		</main>
		<Footer />
	</body>
</html>
