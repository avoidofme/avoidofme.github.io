---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';

import { getCollection } from 'astro:content';
const recent_posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 6);

---

<!doctype html>
<html lang="en">
	<head>
    <BaseHead title=`Home | ${SITE_TITLE}` description={SITE_DESCRIPTION} />
  </head>
	<body>
		<Header />
		<main>
      <b class="avoidofme">avoidofme</b>
      <details open>
        <summary>Latest from the blog</summary>
        <ul>
					{
						recent_posts.map((post) => (
						  <li>
				    		<a href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
                <time datetime={post.data.pubDate.toISOString()}>
                  {
                		post.data.pubDate.toLocaleDateString('en-us', {
              			  year: 'numeric',
                			month: 'short',
              			  day: 'numeric',
              		  })
              	  }
                </time>
							</li>
						))
          }
          <li>
            <a href="/blog">See all</a>
          </li>
				</ul>
      </details>
      <details>
        <summary>Projects</summary>
        <div>
          <div>
            <a href="https://github.com/avoidofme/avps" target="_blank"><h2>AvPS</h2></a>
            <p>AvPS (Average Port Scanner) is a multi-threading TCP port scanner, built with go and its goroutine.</p>
          </div>
          <h3>Personal Projects ↓</h3>
          <div>
            <a href="https://github.com/avoidofme/igtd" target="_blank"><h2>igtd</h2></a>
            <p>Image goes to dracula. I make this command line tool because i recently use dracula theme. Because there are many cool images already why not just change the color into dracula? From Python and PIL, rewriten to Go with imaging and gift also cobra.</p>
          </div>
          <div>
            <a href="https://github.com/avoidofme/von-da-bot" target="_blank"><h2>Von</h2></a>
            <p>Von is a bot specifically for my discord server. I use compose to start the bot, backend and database. Python for the bot, Go for backend and postgresql for database.</p>
          </div>
        </div>
      </details>
      <details>
        <summary>Currently</summary>
        <div>
          <p>Learning Cybersecurity, building personal projects and doing CTFs in my free time.</p>
        </div>
      </details>
      <details>
        <summary>Links</summary>
        <ul class="social-links">
          <li>
            <a href="https://github.com/avoidofme" target="_blank">GitHub</a>
          </li>
          <li>
            <a href="https://linkedin.com/in/avoidofme" target="_blank">LinkedIn</a>
          </li>
          <li>
            <a href="https://learn.cylabacademy.org/users/avoidofme" target="_blank">CyLab</a>
          </li>
          <li>
            <a href="https://tryhackme.com/p/avoidofme" target="_blank">TryHackMe</a>
          </li>
          <li>
            <a href="https://wakatime.com/@avoidofme" target="_blank">wakatime</a>
          </li>
          <li>
            <a href="https://freecodecamp.org/avoidofme" target="_blank">freeCodeCamp</a>
          </li>
          <li>
            <a href="https://bugcrowd.com/h/avoidofme" target="_blank">bugcrowd</a>
          </li>
          <li>
            <a href="https://leetcode.com/u/avom_valtz" target="_blank">LeetCode</a>
          </li>
          <li>
            <a href="https://discord.gg/7GCehbumej" target="_blank">Discord Server</a>
          </li>
        </ul>
      </details>
		</main>
		<Footer />
	</body>
</html>
