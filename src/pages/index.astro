---
import Layout from "../layouts/Layout.astro";

import { getCollection } from "astro:content";
const recent_posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<Layout title="Home" description="homepage">
  <h1 class="text-xl font-bold text-brand-red underline underline-offset-4">
    avoidofme
  </h1>
  <p>Hey there! Care to take a look?</p>
  <div class="space-y-2 px-5 py-2">
    {
      recent_posts.length ? (
        <details open>
          <summary>Latest Posts</summary>
        </details>
      ) : (
        <p>Stay tuned for future blog postings.</p>
      )
    }
    <details>
      <summary>Featured Projects</summary>
    </details>
  </div>
</Layout>

<style>
  details:hover {
    cursor: pointer;
  }

  summary {
    list-style-type: "[+] ";
  }

  details[open] summary {
    list-style-type: "[-] ";
  }
</style>
