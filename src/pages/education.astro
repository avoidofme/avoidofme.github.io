---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="bg-brand-black p-4 max-w-2xl mx-auto mt-20">
        <h1 class="text-3xl font-bold tracking-tight">Education</h1>
        <div class="pl-4 border-l border-brand-gray mt-4">
            <div>
                <p class="text-brand-lightgray text-xl tracking-wider">
                    Sekolah Dasar (SD)
                </p>
                <p>SDN 2 Kresikan</p>
                <p class="text-sm text-brand-gray">2014 - 2019</p>
            </div>
            <div class="leading-tight">
                <p class="text-brand-lightgray text-xl tracking-wider mt-4">
                    Sekolah Menengah Pertama (SMP)
                </p>
                <p>SMPN 1 Tanggunggunung</p>
                <p class="text-sm text-brand-gray">2020 - 2023</p>
            </div>
            <div class="leading-tight">
                <p class="text-brand-lightgray text-xl tracking-wider mt-4">
                    Sekolah Menengah Atas (SMA)
                </p>
                <p>SMAN 1 Campurdarat</p>
                <p class="text-sm text-brand-gray">2024 - 2026</p>
            </div>
            <div class="leading-tight">
                <p class="text-brand-lightgray text-xl tracking-wider mt-4">
                    Self-Taught
                </p>
                <p>
                    Learning from the internet and doing hands-on projects and
                    labs.
                </p>
                <p class="text-sm text-brand-gray">2021 - Present</p>
            </div>
        </div>
    </div>
</Layout>
