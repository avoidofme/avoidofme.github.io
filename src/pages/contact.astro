        <h1 class="text-3xl font-bold tracking-tight">Let's Connect</h1>
        <p>Feel free to contact me.</p>
        <div class="pl-4 border-l border-8 mt-4">
            <div>
                <p class="text-7 text-xl tracking-wider">Location</p>
                <p>Tulungagung, East Java, Indonesia</p>
            </div>
            <div class="leading-tight">
                <p class="text-7 text-xl tracking-wider mt-4">Email</p>
                <a
                    class="underline decoration-dotted hover:text-url"
                    href="mailto:avom.valtz@gmail.com">avom.valtz@gmail.com</a
                >
            </div>
            <div class="leading-tight">
                <p class="text-7 text-xl tracking-wider mt-4">Discord</p>
                <a
                    class="underline decoration-dotted hover:text-url"
                    href="https://discord.com/users/1506166733868630037"
                    >@avoidofme</a
                >
            </div>
        </div>
    </div>
</Layout>
