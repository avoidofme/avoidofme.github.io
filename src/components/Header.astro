---
import { SITE_TITLE } from '../consts';

const { pathname } = Astro.url;

const items = [
  { name: 'Home', url: ''},
  { name: 'Blog', url: 'blog'},
  { name: 'About', url: 'about'},
];
---

<header>
  <nav class="border-y border-x-5 border-brand-foreground/50 flex gap-5 m-5 px-5 py-2 rounded-xl">
    { items.map(item => (
        <a class=`underline underline-offset-4 ${(item.url === '' ? pathname === '/' : pathname.substring(1).startsWith(item.url)) ? 'text-brand-red' : ''}`
          href=`/${item.url}`
        >{ item.name }</a>
      ))
    }
  </nav>
</header>
