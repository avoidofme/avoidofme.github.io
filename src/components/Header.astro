---
const { pathname } = Astro.url;

const items = [
  { name: 'Home', url: ''},
  { name: 'Blog', url: 'blog'},
  { name: 'About', url: 'about'},
];
---

<header class="p-5 shadow-xl shadow-brand-black/50">
  <nav class="flex gap-5 justify-center">
    { items.map(item => (
        <a class=`underline underline-offset-4 transition-transform duration-200 ${(item.url === '' ? pathname === '/' : pathname.substring(1).startsWith(item.url)) ? 'text-brand-red' : ''}`
          href=`/${item.url}`
        >{ item.name }</a>
      ))
    }
  </nav>
</header>
