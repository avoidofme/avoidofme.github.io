---
import { SITE_TITLE } from '../consts';

const { pathname } = Astro.url;

const items = [
  { name: 'Home', url: ''},
  { name: 'Blog', url: 'blog'},
  { name: 'About', url: 'about'},
];
---

<header>
  <nav>
    { items.map(item => (
        <a class={(item.url === '' ? pathname === '/' : pathname.substring(1).startsWith(item.url)) ? 'active' : ''}
        href=`/${item.url}`>{ item.name }</a>
      ))
    }
  </nav>
</header>
