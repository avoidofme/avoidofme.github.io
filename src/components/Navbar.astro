---
const links = [
    { title: "Home", url: "/home" },
    { title: "Blog", url: "/blog" },
    { title: "About", url: "/about" },
];
---

<nav class="flex items-center gap-4 p-2 sticky top-0 mt-4 backdrop-blur-xl">
    <a
        href="/"
        class="p-2 text-xl hover:bg-9 text-9 hover:text-brand-bg transition-color duration-150 font-extrabold tracking-tighter"
        >avom</a
    >
    <div class="flex-1 flex p-2 justify-center bg-0">
        <p class="tracking-widest text-8">{Astro.url.pathname}</p>
    </div>
    <div class="flex">
        {
            links.map((link) => (
                <a
                    href={link.url}
                    class="p-2 bg-0 tracking-tight hover:text-brand-bg hover:bg-brand-accent transition-color duration-150"
                >
                    {link.title}
                </a>
            ))
        }
    </div>
</nav>
