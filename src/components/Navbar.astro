---
const links = [
    { title: "Home", url: "/home" },
    { title: "Blog", url: "/blog" },
    { title: "Projects", url: "/projects" },
    { title: "Skills", url: "/skills" },
    { title: "Gallery", url: "/gallery" },
    { title: "About", url: "/about" },
    { title: "Contact", url: "/contact" },
];
---

<nav
    class="flex items-center justify-between gap-4 px-4 sticky top-0 mt-4 backdrop-blur-xl"
>
    <a
        href="/"
        class="p-2 text-xl hover:bg-9 text-9 hover:text-brand-bg transition-color duration-150 font-extrabold tracking-tighter"
        >avom</a
    >
    <div class="hidden md:flex">
        {
            links.map((link) => (
                <a
                    href={link.url}
                    class="p-2 bg-0 tracking-tight hover:text-brand-bg hover:bg-brand-accent transition-color duration-150"
                >
                    {link.title}
                </a>
            ))
        }
    </div>

    <!-- mobile navigation -->
    <div class="flex flex-col gap-1 md:hidden">
        <input
            type="checkbox"
            class="z-100 peer absolute ml-1 w-4 h-4 opacity-0 cursor-pointer"
        />

        <span
            class="z-99 w-6 h-1 bg-9
            peer-checked:rotate-45 peer-checked:translate-y-2 transition-transform duration-150"
        ></span>
        <span
            class="z-98 w-6 h-1 bg-3
            peer-checked:rotate-45 transition-transform duration-150"
        ></span>
        <span
            class="z-99 w-6 h-1 bg-9
            peer-checked:-rotate-45 peer-checked:-translate-y-2 transition-transform duration-150"
        ></span>

        <div
            class="block absolute left-0 -top-4 h-[85vh] md:h-screen w-0 peer-checked:w-1/2 max-w-screen overflow-hidden bg-brand-bg/80
            transition-all duration-150 ease-out"
        >
            <div class="p-4 flex flex-col mt-12">
                {
                    links.map((link) => (
                        <a href={link.url} class="p-2 tracking-tight font-bold">
                            {link.title}
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</nav>
