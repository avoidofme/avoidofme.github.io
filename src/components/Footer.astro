---
const today = new Date();
const commitHash = import.meta.env.PUBLIC_COMMIT_HASH || "abcdefg";
const commitLink = import.meta.env.PUBLIC_COMMIT_LINK || "#";
---

<footer
	class="border-y border-x-5 border-brand-foreground/50 m-5 px-5 py-2 rounded-xl text-center"
>
	<p>
		<span style="font-family: sans">&copy; </span>
		{today.getFullYear()} avoidofme
	</p>
	<a
		class="text-brand-foreground/30 underline underline-offset-4"
		href={commitLink}
		target={commitLink != "#" ? "_blank" : ""}
	>
		{commitHash}
	</a>
</footer>
