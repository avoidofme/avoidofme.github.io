---
const today = new Date();
const commitHash = import.meta.env.PUBLIC_COMMIT_HASH || "hash";
const commitLink = import.meta.env.PUBLIC_COMMIT_LINK || "#";
---

<footer
    class="text-brand-black border-t mt-5 flex-1 flex items-end justify-center"
>
    <div class="text-sm p-5 text-center text-brand-gray">
        <p class="tracking-widest">
            @{today.getFullYear()} - <a
                href="https://github.com/avoidofme/avoidofme.github.io"
                class="underline decoration-dotted hover:text-brand-link"
                >avoidofme</a
            >
        </p>
        <a
            class="underline text-brand-black decoration-dotted hover:text-brand-link"
            href={commitLink}
            target={commitLink != "#" ? "_blank" : ""}
        >
            {commitHash}
        </a>
    </div>
</footer>
