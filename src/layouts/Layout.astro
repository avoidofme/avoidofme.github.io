---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";

interface Props {
    title: string;
    description: string;
    image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} image={image} />
    </head>
    <body>
        <main>
            <slot />
        </main>
    </body>
</html>
