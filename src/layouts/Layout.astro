---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:title" content={Astro.props.title || "avoidofme"} />
        <meta
            property="og:description"
            content={Astro.props.description || "Obviously simple site."}
        />
        <meta property="og:image" content={Astro.props.image || ""} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url.href} />
        <meta
            property="twitter:title"
            content={Astro.props.title || "avoidofme"}
        />
        <meta
            property="twitter:description"
            content={Astro.props.description || "Obviously simple site."}
        />
        <meta property="twitter:image" content={Astro.props.image || ""} />

        <title>avoidofme</title>
    </head>
    <body
        class="bg-brand-bg text-brand-fg min-h-[85vh] md:min-h-screen flex flex-col"
    >
        {Astro.url.pathname !== "/" && <Navbar />}
        <div class="flex-100 w-7xl max-w-full mx-auto p-4">
            <slot />
        </div>
        {Astro.url.pathname !== "/" && <Footer />}
    </body>
</html>
