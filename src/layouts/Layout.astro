---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description: string;
    image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} image={image} />
    </head>
    <body class="bg-brand-background text-brand-foreground max-w-5xl mx-auto">
        <Header />
        <main
            class="border-y border-x-5 border-brand-foreground/50 space-y-2 m-5 px-5 py-2 rounded-xl"
        >
            <slot />
        </main>
        <Footer />
    </body>
</html>
