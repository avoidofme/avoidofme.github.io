---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description: string;
    image?: ImageMetadata;
    withHeader?: boolean;
    withFooter?: boolean;
}

const {
    title,
    description,
    image,
    withHeader = true,
    withFooter = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} image={image} />
    </head>
    <body
        class="bg-brand-background text-brand-foreground max-w-full w-5xl mx-auto"
    >
        {withHeader ? <Header /> : ""}
        <main
            class="border-x-5 border-brand-foreground/50 min-h-[70vh] space-y-2 m-5 p-5 rounded-xl"
        >
            <slot />
        </main>
        {withFooter ? <Footer /> : ""}
    </body>
</html>
